# Copy to backend/.env for local development. Never commit the real file.

ENVIRONMENT=development

# The application connects as a NON-OWNER role so row level security applies.
DATABASE_URL=postgresql+asyncpg://clinic_app:devpass@127.0.0.1:55432/clinic
# Migrations connect as the owner. Separate credential, separate privilege level.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/clinic

# Swapping the model is a deployment change, not a code change.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

STT_PROVIDER=openai
TTS_PROVIDER=openai

# Fernet key protecting OAuth refresh tokens at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OAUTH_REDIRECT_BASE=http://localhost:8000

DEFAULT_CLINIC_SLUG=brightsmile
