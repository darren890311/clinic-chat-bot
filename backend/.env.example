# Copy to backend/.env for local development. Never commit the real file.

ENVIRONMENT=development

# The application connects as a NON-OWNER role so row level security applies.
DATABASE_URL=postgresql+asyncpg://clinic_app:devpass@127.0.0.1:55432/clinic
# Migrations connect as the owner. Separate credential, separate privilege level.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/clinic

# Swapping the model is a deployment change, not a code change.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Recogniser and voice are separate choices; either can be `null`, which
# turns the microphone button off rather than failing when it is pressed.
STT_PROVIDER=openai
TTS_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Fernet key protecting OAuth refresh tokens at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OAUTH_REDIRECT_BASE=http://localhost:8000

DEFAULT_CLINIC_SLUG=darren-dental

# Guards the calendar-connection endpoints until staff login exists.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Per-million-token list prices, for turning recorded tokens into money on
# /api/usage. Left blank, the endpoint reports counts and no cost: a wrong
# price gets quoted, a missing one prompts somebody to look the current one up.
# Cache reads bill at about 0.1x input; cache writes at 1.25x.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CACHED_PER_MTOK=
PRICE_CACHE_WRITE_PER_MTOK=
